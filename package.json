{
  "name": "h5-pos-print",
  "version": "0.1.0",
  "private": true,
  "description": "CPCL label printing core (WeChat mini program + Android H5 Web Bluetooth)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
